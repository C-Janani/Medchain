# Copy to .env for local development. NEVER commit the real .env.
# On Render, set these in the service's Environment tab instead.

# Port (Render sets this automatically; leave unset there)
PORT=5000

# MongoDB connection string (MongoDB Atlas free tier: mongodb+srv://USER:PASSWORD@CLUSTER/rxchain)
MONGO_URI=

# Long random string used to sign login tokens (required in production)
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Render sets NODE_ENV=production via render.yaml
NODE_ENV=development

# Time zone for medicine reminders
APP_TZ=Asia/Kolkata

# Optional: lets the AI explain medicines that are not in the built-in list
ANTHROPIC_API_KEY=

# Production only: create the first admin account (the README demo passwords are NOT seeded in production)
ADMIN_REGISTRATION_ID=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional: set true to also create the README demo users (DOC-1024 etc.) in production. Not recommended.
SEED_DEFAULT_USERS=

# Optional: only if a separate front-end on another domain must call this API
CORS_ORIGIN=
